# Copy to .env and adjust. The Makefile and docker compose both read it.

POSTGRES_USER=ppe2
POSTGRES_PASSWORD=ppe2
POSTGRES_DB=ppe2
POSTGRES_PORT=5442

API_ADDR=:8090
# The API connects as the least-privilege role ppe_app, as in production; `make
# migrate` lets it sign in with API_DB_PASSWORD. Roles are shared by every database
# on the server, and the Postgres tests and e2e set ppe_app's password to
# ppe-app-test, so keep that value locally. The owner (POSTGRES_USER) runs migrations.
API_DB_USER=ppe_app
API_DB_PASSWORD=ppe-app-test
API_DB_DSN=postgres://${API_DB_USER}:${API_DB_PASSWORD}@localhost:5442/ppe2?sslmode=disable
# Separate database for postgres_test.go; `make db-test-create` creates it.
API_TEST_DB_DSN=postgres://ppe2:ppe2@localhost:5442/ppe2_test?sslmode=disable

# At least 32 bytes. Generate with: openssl rand -base64 48
API_JWT_SECRET=change-me-change-me-change-me-change-me
API_JWT_ISSUER=ppe-next2
# An access token lives API_JWT_TTL; the browser gets new ones with its refresh
# cookie. A sign-in without "Keep me signed in" ends API_SESSION_MAX_AGE after it
# began (and its cookie with the browser); with it, API_SESSION_KEEP_MAX_AGE after
# it began or after API_SESSION_KEEP_IDLE unused. Managing users asks for the
# password again once it was entered more than API_RECENT_SIGN_IN ago.
API_JWT_TTL=15m
API_SESSION_MAX_AGE=12h
# API_SESSION_KEEP_MAX_AGE=720h
# API_SESSION_KEEP_IDLE=336h
# API_RECENT_SIGN_IN=12h

# Sign-in limits: every attempt per client address, and failed attempts per email
# (after API_LOGIN_EMAIL_FAILURES within API_LOGIN_EMAIL_INTERVAL the email waits).
# API_LOGIN_RATE_LIMIT=5
# API_LOGIN_RATE_INTERVAL=1m
# API_LOGIN_EMAIL_FAILURES=10
# API_LOGIN_EMAIL_INTERVAL=15m

# How long security events (sign-ins, failed attempts, ended sessions) are kept,
# 720h to 26280h; older ones are deleted hourly (ADR 0003).
# API_AUTH_EVENTS_RETENTION=4320h

# Prometheus /metrics on its own internal listener; empty serves none.
# API_METRICS_ADDR=:9091

# Reverse proxies (IPs or CIDRs) whose X-Forwarded-For names the client for rate
# limits. Empty: trust none. Behind Caddy on the same host: 127.0.0.1,::1
API_TRUSTED_PROXIES=

# Organisation timezone: History date filters and usage time count days here.
API_ORG_TIMEZONE=Europe/Vilnius

# Where the web app is served; employee confirmation links point here.
API_PUBLIC_BASE_URL=http://localhost:5180
# How long a confirmation link stays usable (1m–2160h).
API_CONFIRM_TTL=168h

# Used only by `make seed-admin`.
API_SEED_USER_EMAIL=admin@example.com
API_SEED_USER_PASSWORD=change-me-please
API_SEED_USER_NAME=Administrator
