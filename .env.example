# Copy to .env and adjust. The Makefile and docker compose both read it.

POSTGRES_USER=ppe2
POSTGRES_PASSWORD=ppe2
POSTGRES_DB=ppe2
POSTGRES_PORT=5442

API_ADDR=:8090
API_DB_DSN=postgres://ppe2:ppe2@localhost:5442/ppe2?sslmode=disable
# Separate database for postgres_test.go; `make db-test-create` creates it.
API_TEST_DB_DSN=postgres://ppe2:ppe2@localhost:5442/ppe2_test?sslmode=disable

# At least 32 bytes. Generate with: openssl rand -base64 48
API_JWT_SECRET=change-me-change-me-change-me-change-me
API_JWT_ISSUER=ppe-next2
API_JWT_TTL=15m

# Organisation timezone: History date filters and usage time count days here.
API_ORG_TIMEZONE=Europe/Vilnius

# Where the web app is served; employee confirmation links point here.
API_PUBLIC_BASE_URL=http://localhost:5180
# How long a confirmation link stays usable (1m–2160h).
API_CONFIRM_TTL=168h

# Used only by `make seed-admin`.
API_SEED_USER_EMAIL=admin@example.com
API_SEED_USER_PASSWORD=change-me-please
API_SEED_USER_NAME=Administrator
