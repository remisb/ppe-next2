{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "make",
      "runtimeArgs": ["run"],
      "port": 8090
    },
    {
      "name": "workwear",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web/apps/workwear", "dev"],
      "port": 5180
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web/apps/admin", "dev"],
      "port": 5182
    },
    {
      "name": "sim-scan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web/apps/sim-scan", "dev"],
      "port": 5184
    },
    {
      "name": "launcher",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web/apps/launcher", "dev"],
      "port": 5186
    },
    {
      "name": "docs-import",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web/apps/docs-import", "dev"],
      "port": 5188
    },
    {
      "name": "ui-sdk-csp-spike",
      "runtimeExecutable": "node",
      "runtimeArgs": ["web/spikes/ui-sdk-csp/node_modules/vite/bin/vite.js", "preview", "web/spikes/ui-sdk-csp", "--port", "5199", "--strictPort"],
      "port": 5199
    },
    {
      "name": "docs-scan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web/apps/docs-scan", "dev"],
      "port": 5190
    },
    {
      "name": "docs-scan-https",
      "runtimeExecutable": "node",
      "runtimeArgs": ["web/apps/docs-scan/node_modules/vite/bin/vite.js", "web/apps/docs-scan"],
      "env": { "VITE_HTTPS": "1" },
      "port": 5190,
      "url": "https://localhost:5190"
    }
  ]
}
