# Copy to .env.prod on the server (chmod 600) and fill in. Read by the prod-*
# make targets and docker-compose.prod.yml; values without a default are required.

# The public hostname; its DNS A record must point at the server before the
# first `make prod-up`, or Let's Encrypt's challenge fails.
SITE_HOST=ppe.example.com
# 0 on a shared zone (sslip.io, nip.io): HSTS there would pin other people's hosts.
HSTS_MAX_AGE=31536000

# The database image, shared by db, migrate and backup. Changing the major
# version needs the upgrade steps in docs/backups.md (and POSTGRES_VOLUME).
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=ppe2
POSTGRES_DB=ppe2
# openssl rand -hex 24
POSTGRES_PASSWORD=
# The API connects as the least-privilege role ppe_app (migration 0026) once
# both are set: it cannot change or delete the audit trail. Generate the
# password like the others (openssl rand -hex 32); `make prod-up` applies it.
# Unset, the API connects as POSTGRES_USER and the Overview warns.
# API_DB_USER=ppe_app
# API_DB_PASSWORD=
# openssl rand -hex 32 (at least 32 bytes)
API_JWT_SECRET=
# Each day's audit seal is anchored by a trusted timestamp (RFC 3161) from this
# service; only the seal's hash is sent. Unset, DigiCert's is used; set it
# empty to stop timestamping.
# API_AUDIT_TSA_URL=http://timestamp.digicert.com

API_ORG_TIMEZONE=Europe/Vilnius
API_CONFIRM_TTL=168h

# The first admin: `make prod-seed-admin`. Remove the password afterwards.
API_SEED_USER_EMAIL=
API_SEED_USER_NAME=Administrator
API_SEED_USER_PASSWORD=

# Backups (docs/backups.md). The image builds also need the file .github-token
# beside this one: a GitHub token that can read remisb/dbbackup (chmod 600).
#DBBACKUP_VERSION=v0.1.0 Without these the agent backs up nightly to a
# volume on this server only, which is lost with the server.
#DBBACKUP_SCHEDULE=0 3 * * *
#DBBACKUP_KEEP_DAYS=14
#DBBACKUP_KEEP_LAST=7
# A private DigitalOcean Spaces bucket, preferably in another region than the droplet:
#DBBACKUP_TARGET=s3://ppe-next2-backups/prod?endpoint=fra1.digitaloceanspaces.com&region=fra1
#DBBACKUP_S3_ACCESS_KEY=
#DBBACKUP_S3_SECRET_KEY=
# Optional encryption: the public key printed by `age-keygen -o backup.key`.
# Keep backup.key itself off this server; it is needed only to restore.
#DBBACKUP_ENCRYPT=age:age1...
