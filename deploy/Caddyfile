# Serves the built web app and proxies the API on one origin.
#
#   SITE_ADDRESS  public domain (Caddy obtains TLS automatically), or
#                 http://host:port for plain HTTP, as CI does
#   API_UPSTREAM  where the Go API listens
#   WEB_ROOT      web/apps/workwear/dist from `pnpm build`: the staff app, at /
#   ADMIN_ROOT    web/apps/admin/dist: Administration, at /admin/ (its Vite
#                 base, and adminBase in @ppe/routing)
#   LAUNCHER_ROOT web/apps/launcher/dist: App Launcher, at /apps/
#                 (launcherBase in @ppe/routing; ADR 0006)
#   PUBLISHED_ROOT the published apps' builds (the API's API_APPS_DIR, the
#                 `published` volume), <profile>/<slug>/<version>/, read only
#   HSTS_MAX_AGE  seconds; set 0 on a shared zone such as sslip.io, where a pin
#                 would outlive the demo and cannot be taken back

# Other sites this Caddy serves for applications sharing the host, one file
# each in deploy/sites/ (mounted at /etc/caddy/sites). They belong to those
# applications and are not committed here; with none present this imports
# nothing.
import sites/*.caddy

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Where password managers send people to change a saved password (the W3C
	# "well-known URL for changing passwords"): the Account screen, after sign-in.
	redir /.well-known/change-password /account 302

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:8090}
	}
	# /health: the API process answers. /ready: it also reaches a migrated
	# database; the external uptime check watches it (docs/monitoring.md).
	@probe path /health /ready
	handle @probe {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:8090}
	}
	# Scan SIMs moved under /apps/ when it was published (ADR 0006, phase 3);
	# its old addresses still open it.
	redir /sim-scan /apps/sim-scan/ 308
	@oldsimscan path_regexp oldsimscan ^/sim-scan/(.*)$
	redir @oldsimscan /apps/sim-scan/{re.oldsimscan.1} 308
	# App Launcher (ADR 0006), every app a user's roles open, on the same
	# origin as the staff app, so they share the sign-in cookie: /apps/ and
	# its files are the launcher's.
	redir /apps /apps/ 308
	@launcher path /apps/ /apps/index.html /apps/assets/*
	handle @launcher {
		# header runs before uri, so it matches the path as requested.
		uri strip_prefix /apps
		root * {$LAUNCHER_ROOT:/srv/launcher/dist}
		@unhashed not path /apps/assets/*
		header /apps/assets/* Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control "no-cache"
		file_server
	}
	# Published apps' files, by the profile their version declared (a closed
	# list: launcher.Capabilities). A version's files never change. Nothing
	# else under PUBLISHED_ROOT (the API's .incoming) is served.
	@published path /apps/files/standard/* /apps/files/device/*
	handle @published {
		uri strip_prefix /apps/files
		root * {$PUBLISHED_ROOT:/srv/published}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /apps/files/* {
		respond 404
	}
	# Every other address under /apps/ is a published app's page
	# (/apps/<slug>/, /apps/<slug>/<channel>/, /apps/<slug>/@<version>/ and
	# the app's own screens): the API answers its version's index.html with
	# the profile's policy (cmd/api/published-app-routes.go).
	handle /apps/* {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:8090}
	}
	# Administration: the same origin as the staff app, so the two share the
	# sign-in cookie. handle_path strips /admin, so its built /admin/assets/*
	# are the files under ADMIN_ROOT/assets.
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * {$ADMIN_ROOT:/srv/admin/dist}
		@unhashed not path /assets/*
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	handle {
		root * {$WEB_ROOT:/srv/workwear/dist}
		# Hashed file names never change content; index.html points at them,
		# so it must never be cached. Headers match the requested path, before
		# try_files rewrites an app route such as /users to index.html, so
		# everything outside /assets is no-cache, not just / and /index.html.
		@unhashed not path /assets/*
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Only the app's own files may run or load, which keeps an injected script
	# from running or sending data anywhere. The one inline script, the theme
	# in index.html (the same in every app), is allowed by its hash;
	# web/apps/{workwear,admin,sim-scan,launcher}/src/csp.test.ts fail when they drift apart. Inline styles React sets through the DOM
	# are not affected by style-src. frame-ancestors is 'self', not 'none': the
	# PDF preview's blob: frame inherits this policy, and Safari applies the
	# inherited frame-ancestors to it, so 'none' left the preview blank there.
	# Other sites still may not frame the app; X-Frame-Options stays DENY for
	# browsers without frame-ancestors.
	#
	# Not in the header block above: its -Server defers the whole block, which
	# would then write over a policy set for one path. The staff app's and
	# Administration's policy stays first, as their csp.test.ts read the first.
	# A published app's page gets its policy from the API, so none is set
	# here (two would both be enforced); its files get their profile's, which
	# matters for a worker, whose script's own policy is the one it runs under.
	# The device profile (Scan SIMs, ADR 0005) may also compile WebAssembly
	# (its barcode and text readers) and start workers from its own files, and
	# use the camera. cmd/api's TestPublishedPoliciesMatchCaddy keeps the API's
	# copies of both policies equal to these.
	@staffpolicy {
		not {
			path_regexp ^/apps/[^/]+/
			not path /apps/assets/* /apps/files/standard/*
		}
	}
	@devicepolicy path /apps/files/device/*
	header @staffpolicy Content-Security-Policy "default-src 'self'; frame-src 'self' blob:; script-src 'self' 'sha256-AKRvWbdPuFGkTUGtgLGUciQLScPr+u526xsQQFr2xgU='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
	header @devicepolicy {
		Content-Security-Policy "default-src 'self'; frame-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval' 'sha256-AKRvWbdPuFGkTUGtgLGUciQLScPr+u526xsQQFr2xgU='; worker-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
		Permissions-Policy "camera=(self)"
	}
}
