# The context of web/Dockerfile. Anything left out here cannot invalidate the
# image's build layer.
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo
**/*.test.ts
**/*.test.tsx
AGENTS.md
# The lockfile names e2e as a workspace package, so its manifest stays.
e2e/*
!e2e/package.json
# make new-app's template: make new-app copies it into apps/, the image never builds it.
templates
# Throwaway spikes are never built into the image; the lockfile names them, so their manifests stay.
spikes/*/*
!spikes/*/package.json
