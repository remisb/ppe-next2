{
  "name": "@ppe/sim-scan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Scan SIMs: reading SIM card carriers (the SIM No. barcode, the printed PIN and PUK) in the browser, pairing fronts and backs, and the review list's rules. Used by the trial app at /sim-scan/, later by the staff app.",
  "exports": {
    ".": "./src/index.ts",
    "./readers": "./src/readers.ts",
    "./camera": "./src/camera.ts",
    "./reader-files": "./src/reader-files.ts",
    "./review-list": "./src/review-list.tsx"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ppe/api-client": "workspace:*",
    "@ppe/i18n": "workspace:*",
    "@ppe/ui": "workspace:*",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
