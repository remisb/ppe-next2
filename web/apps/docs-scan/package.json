{
  "name": "@ppe/docs-scan-app",
  "private": true,
  "version": "0.0.0",
  "description": "Scan Documents (docs/apps/docs-scan-plan.md): a phone app that photographs a passport or ID card, reads its MRZ in the browser, finds the employee (Match), updates, merges or adds them and saves the document to the personnel file. Published under App Launcher at /apps/docs-scan/ with the device profile (ADR 0006); replaces Import Documents after its trial.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ppe/api-client": "workspace:*",
    "@ppe/app-shell": "workspace:*",
    "@ppe/i18n": "workspace:*",
    "@ppe/id-docs": "workspace:*",
    "@ppe/launcher": "workspace:*",
    "@ppe/mrz": "workspace:*",
    "@ppe/routing": "workspace:*",
    "@ppe/scan-kit": "workspace:*",
    "@ppe/ui": "workspace:*",
    "@tesseract.js-data/lit": "1.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
