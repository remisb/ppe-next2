{
  "name": "@ppe/docs-import-app",
  "private": true,
  "version": "0.0.0",
  "description": "Import Documents (docs-import), a published app at /apps/docs-import/ (ADR 0006, ADR 0007): a passport's or ID card's machine-readable zone read in the browser from photos, checked, and saved to Personnel files, sealed. Started from web/templates/published-app by make new-app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ppe/api-client": "workspace:*",
    "@ppe/app-shell": "workspace:*",
    "@ppe/i18n": "workspace:*",
    "@ppe/launcher": "workspace:*",
    "@ppe/mrz": "workspace:*",
    "@ppe/routing": "workspace:*",
    "@ppe/scan-kit": "workspace:*",
    "@ppe/ui": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
